# CampusFind AI - Environment Configuration Example
# Copy this file to .env and customize for your environment. Never commit production .env files.

# Server Configuration
PORT=8080

# Database Configuration (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/campusfind_db
DATABASE_USERNAME=campusfind_user
DATABASE_PASSWORD=your_secure_password_here

# JWT Authentication
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# File Storage
STORAGE_PATH=uploads

# AI Multimodal Vision & Description Configuration
# Providers supported: gemini, openai, local
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# Smart Matching Weights (must sum to ~1.00)
MATCH_WEIGHT_CATEGORY=0.25
MATCH_WEIGHT_COLOR=0.15
MATCH_WEIGHT_BRAND=0.15
MATCH_WEIGHT_LOCATION=0.15
MATCH_WEIGHT_TIME=0.10
MATCH_WEIGHT_SEMANTIC=0.20
MATCH_WEIGHT_VISUAL=0.00
MATCH_THRESHOLD=50
